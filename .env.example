PORT=4000

# Neon gives you a connection string like:
#   postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
# Spring/JDBC needs it split into three pieces instead:
DATABASE_URL=jdbc:postgresql://ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_USERNAME=your-neon-username
DATABASE_PASSWORD=your-neon-password

# Any long (32+ char) random string — used to sign dashboard login sessions
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# Claude API key, used to parse raw messages into structured lead data
ANTHROPIC_API_KEY=sk-ant-...

# Any string you choose — set the same value in the Meta WhatsApp webhook config
WHATSAPP_VERIFY_TOKEN=choose-any-string-and-set-the-same-in-meta-dashboard
